# --- Cloud API keys (only needed for the providers you actually use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=

# --- Ollama ---
# Local instance (small models, no key required)
OLLAMA_BASE_URL=http://localhost:11434
# Hosted inference at ollama.com (get a key at https://ollama.com/settings/keys)
OLLAMA_API_KEY=

# --- Local model overrides (--local / --mixed) ---
OLLAMA_SMALL_MODEL=qwen3.5:2b
OLLAMA_SMALL_MODEL_2=gemma3:1b
OLLAMA_SMALL_MODEL_3=llama3.2:1b
OLLAMA_SMALL_MODEL_4=smollm2:1.7b
OLLAMA_SMALL_MODEL_5=granite3.1-dense:2b

# --- Cloud Ollama model overrides (--cloud) ---
CLOUD_MODEL_1=gpt-oss:120b
CLOUD_MODEL_2=gemini-3-flash-preview:cloud
CLOUD_MODEL_3=glm-5.1:cloud
CLOUD_MODEL_4=nemotron-3-super:cloud
CLOUD_MODEL_5=rnj-1:8b-cloud

# --- Game settings ---
LOG_DIR=./logs
# How much of the record each agent sees: "ledger" (compressed) or "full" (raw transcript)
CONTEXT_MODE=ledger
# Statements per player per day phase
DISCUSSION_ROUNDS=1
# Hard cap on days before the game is called a draw
MAX_DAYS=12
# Reveal an eliminated player's role to everyone
REVEAL_ROLE_ON_DEATH=true
# Fixed seed for reproducible games (blank = random)
SEED=
